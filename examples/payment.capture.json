{
  "id": "example.payment.capture",
  "version": "2026-04-09",
  "entryStepId": "prepare_capture",
  "steps": {
    "prepare_capture": {
      "id": "prepare_capture",
      "type": "PROCESS",
      "subtype": "MAPPINGS",
      "artefactId": "process.prepareCapture",
      "nextStepId": "call_capture",
      "contract": {
        "input": {
          "ref": "$.context.input"
        },
        "output": {
          "ref": "$.context.facts.capturePayload"
        }
      }
    },
    "call_capture": {
      "id": "call_capture",
      "type": "EFFECT",
      "subtype": "CALL",
      "operationId": "payment.capture",
      "inputRef": "$.context.facts.capturePayload",
      "nextStepId": "finish_complete",
      "onErrorStepId": "finish_fail"
    },
    "finish_complete": {
      "id": "finish_complete",
      "type": "TERMINAL",
      "subtype": "COMPLETE",
      "result": {
        "status": "COMPLETE",
        "outcome": "CAPTURED"
      }
    },
    "finish_fail": {
      "id": "finish_fail",
      "type": "TERMINAL",
      "subtype": "FAIL",
      "result": {
        "status": "FAIL",
        "outcome": "CAPTURE_FAILED"
      }
    }
  }
}
