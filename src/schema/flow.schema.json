{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://processengine.dev/schemas/flow5-3.0.0.schema.json",
  "title": "@processengine/semantics v3.0.0 — Flow 5 FlowDefinition",
  "description": "JSON Schema for Flow 5 DSL artifacts on State v2. PROCESS/DATA replaces PROCESS/RULES/MAPPINGS/DECISIONS. CONTROL/ROUTE replaces CONTROL/SWITCH. Runtime state uses root input/data/steps/timeline/result, not context/history.",
  "type": "object",
  "required": ["id", "version", "title", "description", "entryStepId", "steps"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "entryStepId": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/StepDefinition" }
    }
  },
  "$defs": {
    "JsonObject": {
      "type": "object"
    },
    "StepMetadata": {
      "type": "object"
    },
    "StepDefinition": {
      "oneOf": [
        { "$ref": "#/$defs/DataStep" },
        { "$ref": "#/$defs/RouteStep" },
        { "$ref": "#/$defs/EffectStep" },
        { "$ref": "#/$defs/WaitStep" },
        { "$ref": "#/$defs/TerminalStep" }
      ]
    },
    "DataStep": {
      "description": "PROCESS/DATA — the only PROCESS step in Flow 5. Delegates synchronous data processing to a dataflow artifact. No contract.input/output on the step — the dataflow artifact owns that.",
      "type": "object",
      "required": ["id", "type", "subtype", "title", "description", "artefactId", "nextStepId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "PROCESS" },
        "subtype": { "const": "DATA" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/StepMetadata" },
        "artefactId": { "type": "string", "minLength": 1, "description": "ID of the dataflow artifact to execute" },
        "nextStepId": { "type": "string", "minLength": 1 }
      }
    },
    "RouteStep": {
      "description": "CONTROL/ROUTE — the only CONTROL step in Flow 5. Reads any scalar from state by ref and dispatches to cases. Use 'ref' not 'factRef'.",
      "type": "object",
      "required": ["id", "type", "subtype", "title", "description", "ref", "cases", "defaultNextStepId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "CONTROL" },
        "subtype": { "const": "ROUTE" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/StepMetadata" },
        "ref": { "type": "string", "minLength": 1, "pattern": "^\\$\\.data\\.", "description": "PathRef to scalar in State v2 data. Missing -> FLOW_ROUTE_REF_NOT_RESOLVED. Object/array -> FLOW_ROUTE_REF_NOT_SCALAR." },
        "cases": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "defaultNextStepId": { "type": "string", "minLength": 1 }
      }
    },
    "EffectStep": {
      "description": "EFFECT — COMMAND and SUBFLOW may start async lifecycle through WAIT. CALL is synchronous and must not transition to WAIT. onErrorStepId is required.",
      "type": "object",
      "required": ["id", "type", "subtype", "title", "description", "operationId", "inputRef", "nextStepId", "onErrorStepId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "EFFECT" },
        "subtype": { "enum": ["COMMAND", "CALL", "SUBFLOW"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/StepMetadata" },
        "operationId": { "type": "string", "minLength": 1 },
        "inputRef": { "type": "string", "minLength": 1, "pattern": "^\\$\\.(input|data)(\\.|$)", "description": "String PathRef only. Object inputRef was removed in Flow 5. EFFECT input must read from State v2 input or data." },
        "nextStepId": { "type": "string", "minLength": 1 },
        "onErrorStepId": { "type": "string", "minLength": 1, "description": "Required. External failure is a lifecycle outcome." },
        "onTimeoutStepId": { "type": "string", "minLength": 1 },
        "flowId": { "type": "string", "minLength": 1, "description": "Required for SUBFLOW only" },
        "flowVersion": { "type": "string", "minLength": 1, "description": "Required for SUBFLOW only" }
      },
      "allOf": [
        {
          "if": { "properties": { "subtype": { "const": "SUBFLOW" } }, "required": ["subtype"] },
          "then": { "required": ["flowId", "flowVersion"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["flowId"] },
                { "required": ["flowVersion"] }
              ]
            }
          }
        }
      ]
    },
    "WaitStep": {
      "description": "WAIT/MESSAGE — waits for async response from a prior EFFECT step.",
      "type": "object",
      "required": ["id", "type", "subtype", "title", "description", "sourceStepId", "nextStepId", "onErrorStepId", "onTimeoutStepId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "WAIT" },
        "subtype": { "const": "MESSAGE" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/StepMetadata" },
        "sourceStepId": { "type": "string", "minLength": 1, "description": "Must reference an EFFECT step." },
        "nextStepId": { "type": "string", "minLength": 1 },
        "onErrorStepId": { "type": "string", "minLength": 1 },
        "onTimeoutStepId": { "type": "string", "minLength": 1 }
      }
    },
    "TerminalStep": {
      "description": "TERMINAL — COMPLETE or FAIL. result.status must match subtype. resultRef must point into $.data.results.*",
      "type": "object",
      "required": ["id", "type", "subtype", "title", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "TERMINAL" },
        "subtype": { "enum": ["COMPLETE", "FAIL"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/StepMetadata" },
        "result": {
          "type": "object",
          "required": ["status", "outcome"],
          "properties": {
            "status": { "type": "string", "minLength": 1, "description": "Must equal TERMINAL subtype: COMPLETE or FAIL" },
            "outcome": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": true
        },
        "resultRef": { "type": "string", "pattern": "^\\$\\.data\\.results\\.", "description": "Must start with $.data.results." }
      },
      "allOf": [
        {
          "if": { "properties": { "subtype": { "const": "COMPLETE" } }, "required": ["subtype", "result"] },
          "then": { "properties": { "result": { "properties": { "status": { "const": "COMPLETE" } } } } }
        },
        {
          "if": { "properties": { "subtype": { "const": "FAIL" } }, "required": ["subtype", "result"] },
          "then": { "properties": { "result": { "properties": { "status": { "const": "FAIL" } } } } }
        }
      ],
      "oneOf": [
        { "required": ["result"], "not": { "required": ["resultRef"] } },
        { "required": ["resultRef"], "not": { "required": ["result"] } }
      ]
    }
  }
}
